            &copy; 2026 NeoSport. Todos los derechos reservados.
        </div>
    </footer>


    <div id="cart-overlay" class="fixed inset-0 bg-slate-950/40 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300" onclick="toggleCart()"></div>


    <aside id="cart-modal" class="fixed top-0 right-0 h-full w-full max-w-md bg-white dark:bg-slate-900 z-50 shadow-2xl translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-4 border-b border-slate-100 dark:border-slate-800 flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                <i class="fa-solid fa-bag-shopping text-indigo-600"></i> Tu Carrito
            </h3>
            <button onclick="toggleCart()" class="p-2 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg transition"><i class="fa-solid fa-xmark text-lg"></i></button>
        </div>


        <div id="cart-items" class="flex-1 overflow-y-auto p-4 space-y-4">

        </div>


        <div class="p-4 border-t border-slate-100 dark:border-slate-800 space-y-4">
            <div class="flex justify-between text-base font-bold text-slate-900 dark:text-white">
                <span>Total</span>
                <span id="cart-total">$0.00</span>
            </div>
            <button onclick="abrirCheckout()" class="w-full py-3 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-lg transition">Proceder al Pago</button>
        </div>
    </aside>


    <div id="checkout-modal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 opacity-0 pointer-events-none transition-opacity duration-300 flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-900 rounded-2xl max-w-md w-full p-6 border border-slate-100 dark:border-slate-800 space-y-4 shadow-xl">
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Detalles del Pedido</h3>
            <form id="checkout-form" onsubmit="procesarCompra(event)" class="space-y-3">
                <div>
                    <label for="cliente-nombre" class="block text-xs font-semibold text-slate-500 mb-1">Nombre Completo</label>
                    <input type="text" id="cliente-nombre" required class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:text-white">
                </div>
                <div>
                    <label for="cliente-email" class="block text-xs font-semibold text-slate-500 mb-1">Correo Electrónico</label>
                    <input type="email" id="cliente-email" required class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:text-white">
                </div>
                <div>
                    <label for="cliente-direccion" class="block text-xs font-semibold text-slate-500 mb-1">Dirección de Envío</label>
                    <input type="text" id="cliente-direccion" required class="w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:text-white">
                </div>
                <div class="flex gap-2 pt-2">
                    <button type="button" onclick="cerrarCheckout()" class="flex-1 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 font-semibold text-sm hover:bg-slate-50 dark:hover:bg-slate-800 transition">Cancelar</button>
                    <button type="submit" class="flex-1 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-sm rounded-xl transition">Confirmar Pago</button>
                </div>
            </form>
        </div>
    </div>


    <div id="custom-alert" class="fixed bottom-4 right-4 z-50 bg-slate-900 text-white dark:bg-white dark:text-slate-900 px-4 py-3 rounded-xl shadow-lg transform translate-y-20 opacity-0 transition-all duration-300 text-sm font-semibold flex items-center gap-2">
        <i class="fa-solid fa-circle-info text-indigo-400 dark:text-indigo-600"></i>
        <span id="alert-message">Notificación</span>
    </div>


    <script>

        const productos = [
            { id: 1, nombre: "Red Speed Runner", categoria: "Running", precio: 129.99, stock: 5, imagen: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&q=80&w=600" },
            { id: 2, nombre: "Puma Ultra Light", categoria: "Running", precio: 145.00, stock: 8, imagen: "https://images.unsplash.com/photo-1608231387042-66d1773070a5?auto=format&fit=crop&q=80&w=600" },
            { id: 3, nombre: "Air Max Pro", categoria: "Urbano", precio: 110.00, stock: 3, imagen: "https://images.unsplash.com/photo-1551107696-a4b0c5a0d9a2?auto=format&fit=crop&q=80&w=600" },
            { id: 4, nombre: "Classic Street", categoria: "Urbano", precio: 89.99, stock: 10, imagen: "https://images.unsplash.com/photo-1525966222134-fcfa99b8ae77?auto=format&fit=crop&q=80&w=600" },
            { id: 5, nombre: "Crossfit Matrix", categoria: "Entrenamiento", precio: 135.50, stock: 4, imagen: "https://images.unsplash.com/photo-1584735935682-2f2b69dff9d2?auto=format&fit=crop&q=80&w=600" },
            { id: 6, nombre: "Flex Trainer", categoria: "Entrenamiento", precio: 95.00, stock: 6, imagen: "https://images.unsplash.com/photo-1579338559194-a162d19bf842?auto=format&fit=crop&q=80&w=600" },
            { id: 7, nombre: "Neon Sprint Zero", categoria: "Running", precio: 119.99, stock: 7, imagen: "https://images.unsplash.com/photo-1595950653106-6c9ebd614d3a?auto=format&fit=crop&q=80&w=600" },
            { id: 8, nombre: "Retro High Top", categoria: "Basketball", precio: 160.00, stock: 4, imagen: "https://images.unsplash.com/photo-1512374382149-233c42b6a83b?auto=format&fit=crop&q=80&w=600" },
            { id: 9, nombre: "Urban Black Sole", categoria: "Urbano", precio: 105.00, stock: 9, imagen: "https://images.unsplash.com/photo-1560769629-975ec94e6a86?auto=format&fit=crop&q=80&w=600" },
            { id: 10, nombre: "Court King Elite", categoria: "Basketball", precio: 175.00, stock: 5, imagen: "https://images.unsplash.com/photo-1575537302964-96cd47c06b1b?auto=format&fit=crop&q=80&w=600" },
            { id: 11, nombre: "Powerlift Gym Pro", categoria: "Entrenamiento", precio: 140.00, stock: 6, imagen: "https://images.unsplash.com/photo-1582588678413-dbf45f4823e9?auto=format&fit=crop&q=80&w=600" },
            { id: 12, nombre: "Trail Master Carbon", categoria: "Running", precio: 155.00, stock: 3, imagen: "https://images.unsplash.com/photo-1606107557195-0e29a4b5b4aa?auto=format&fit=crop&q=80&w=600" }
        ];

        let carrito = JSON.parse(localStorage.getItem('carrito_app')) || [];


        document.addEventListener("DOMContentLoaded", () => {
            initTheme();
            renderizarProductos('todos');
            actualizarCarritoUI();
        });


        function initTheme() {
            if (localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
                document.getElementById('theme-toggle-light-icon').classList.remove('hidden');
                document.getElementById('theme-toggle-dark-icon').classList.add('hidden');
            } else {
                document.documentElement.classList.remove('dark');
                document.getElementById('theme-toggle-dark-icon').classList.remove('hidden');
                document.getElementById('theme-toggle-light-icon').classList.add('hidden');
            }
        }

        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                localStorage.theme = 'light';
            } else {
                document.documentElement.classList.add('dark');
                localStorage.theme = 'dark';
            }
            initTheme();
        }


        function renderizarProductos(categoria) {
            const container = document.getElementById('grid-productos');
            container.innerHTML = '';

            const filtrados = categoria === 'todos' 
                ? productos 
                : productos.filter(p => p.categoria === categoria);

            filtrados.forEach(prod => {
                const card = document.createElement('div');
                card.className = "bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-100 dark:border-slate-800 shadow-sm hover:shadow-md transition flex flex-col justify-between";
                card.innerHTML = `
                    <div>
                        <div class="relative overflow-hidden rounded-xl bg-slate-100 dark:bg-slate-800 aspect-square mb-4">
                            <img src="${prod.imagen}" alt="${prod.nombre}" class="w-full h-full object-cover transform hover:scale-105 transition duration-500">
                            <span class="absolute top-2 right-2 bg-slate-900/70 text-white text-[10px] uppercase tracking-wider font-bold px-2 py-1 rounded-md backdrop-blur-sm">${prod.categoria}</span>
                        </div>
                        <h3 class="font-bold text-slate-900 dark:text-white">${prod.nombre}</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Stock disponible: ${prod.stock}</p>
                    </div>
                    <div class="flex items-center justify-between mt-4">
                        <span class="text-lg font-black text-slate-900 dark:text-white">$${prod.precio.toFixed(2)}</span>
                        <button onclick="agregarAlCarrito(${prod.id})" class="px-3.5 py-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-indigo-600 dark:hover:bg-indigo-400 dark:hover:text-white font-semibold text-xs rounded-xl transition">Añadir</button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function filtrarProductos(cat, btnElement) {
            document.querySelectorAll('.filtro-btn').forEach(btn => {
                btn.className = "filtro-btn px-4 py-2 rounded-xl text-sm font-semibold bg-white dark:bg-slate-900 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 transition";
            });
            if (btnElement) {
                btnElement.className = "filtro-btn px-4 py-2 rounded-xl text-sm font-semibold bg-indigo-600 text-white shadow-sm transition";
            }
            renderizarProductos(cat);
        }


        function agregarAlCarrito(id) {
            const prod = productos.find(p => p.id === id);
            if (!prod) return;

            const itemExistente = carrito.find(item => item.id === id);

            if (itemExistente) {
                if (itemExistente.cantidad < prod.stock) {
                    itemExistente.cantidad++;
                    showCustomMessage(`Unidad agregada: ${prod.nombre}`);
                } else {
                    showCustomMessage("Has alcanzado el límite de stock de este producto.");
                    return;
                }
            } else {
                carrito.push({ ...prod, cantidad: 1 });
                showCustomMessage(`${prod.nombre} añadido al carrito`);
            }

            guardarYActualizar();
        }

        function agregarDirecto(nombre, precio, imagen) {
            const prodExistente = productos.find(p => p.nombre === nombre);
            const id = prodExistente ? prodExistente.id : Date.now();
            const stock = prodExistente ? prodExistente.stock : 10;

            const index = carrito.findIndex(item => item.nombre === nombre);
            if (index > -1) {
                if (carrito[index].cantidad < stock) {
                    carrito[index].cantidad++;
                } else {
                    showCustomMessage("No hay más stock disponible para este modelo.");
                    return;
                }
            } else {
                carrito.push({ id, nombre, precio, imagen, cantidad: 1, stock });
            }
            guardarYActualizar();
            toggleCart();
        }

        function cambiarCantidad(id, delta) {
            const index = carrito.findIndex(item => item.id === id);
            if (index > -1) {
                const item = carrito[index];
                const nuevoValor = item.cantidad + delta;

                if (nuevoValor <= 0) {
                    carrito.splice(index, 1);
                } else if (nuevoValor <= item.stock) {
                    item.cantidad = nuevoValor;
                } else {
                    showCustomMessage("Límite de stock alcanzado.");
                    return;
                }
                guardarYActualizar();
            }
        }

        function guardarYActualizar() {
            localStorage.setItem('carrito_app', JSON.stringify(carrito));
            actualizarCarritoUI();
        }

        function actualizarCarritoUI() {
            const cartCount = document.getElementById('cart-count');
            const cartItems = document.getElementById('cart-items');
            const cartTotal = document.getElementById('cart-total');

            const totalUnidades = carrito.reduce((sum, i) => sum + i.cantidad, 0);
            cartCount.textContent = totalUnidades;

            cartItems.innerHTML = '';
            let totalPrecio = 0;

            if (carrito.length === 0) {
                cartItems.innerHTML = `
                    <div class="h-full flex flex-col items-center justify-center text-slate-400 space-y-2">
                        <i class="fa-solid fa-cart-flatbed text-4xl"></i>
                        <p class="text-sm">Tu carrito está vacío</p>
                    </div>
                `;
            } else {
                carrito.forEach(item => {
                    totalPrecio += item.precio * item.cantidad;
                    const el = document.createElement('div');
                    el.className = "flex items-center justify-between bg-slate-50 dark:bg-slate-800/50 p-3 rounded-xl border border-slate-100 dark:border-slate-800";
                    el.innerHTML = `
                        <div class="flex items-center gap-3">
                            <img src="${item.imagen}" alt="${item.nombre}" class="w-12 h-12 rounded-lg object-cover">
                            <div>
                                <h4 class="font-bold text-sm text-slate-900 dark:text-white">${item.nombre}</h4>
                                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">$${(item.precio * item.cantidad).toFixed(2)}</span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="cambiarCantidad(${item.id}, -1)" class="w-6 h-6 rounded-md bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-200 border border-slate-200 dark:border-slate-600 flex items-center justify-center text-xs hover:bg-slate-100 transition">-</button>
                            <span class="text-xs font-bold text-slate-900 dark:text-white w-4 text-center">${item.cantidad}</span>
                            <button onclick="cambiarCantidad(${item.id}, 1)" class="w-6 h-6 rounded-md bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-200 border border-slate-200 dark:border-slate-600 flex items-center justify-center text-xs hover:bg-slate-100 transition">+</button>
                        </div>
                    `;
                    cartItems.appendChild(el);
                });
            }

            cartTotal.textContent = `$${totalPrecio.toFixed(2)}`;
        }


        function toggleCart() {
            const overlay = document.getElementById('cart-overlay');
            const modal = document.getElementById('cart-modal');
            const isOpen = !modal.classList.contains('translate-x-full');

            if (isOpen) {
                modal.classList.add('translate-x-full');
                overlay.classList.add('opacity-0', 'pointer-events-none');
            } else {
                modal.classList.remove('translate-x-full');
                overlay.classList.remove('opacity-0', 'pointer-events-none');
            }
        }

        function abrirCheckout() {
            if (carrito.length === 0) {
                showCustomMessage("Añade al menos un producto al carrito");
                return;
            }
            toggleCart();
            const modal = document.getElementById('checkout-modal');
            modal.classList.remove('opacity-0', 'pointer-events-none');
        }

        function cerrarCheckout() {
            const modal = document.getElementById('checkout-modal');
            modal.classList.add('opacity-0', 'pointer-events-none');
        }

        function procesarCompra(e) {
            e.preventDefault();
            cerrarCheckout();
            carrito = [];
            guardarYActualizar();
            showCustomMessage("¡Compra realizada con éxito!");
            document.getElementById('checkout-form').reset();
        }


        function scrollCarrusel(direccion) {
            const container = document.getElementById('carrusel-container');
            const scrollAmount = 300;
            container.scrollBy({ left: direccion * scrollAmount, behavior: 'smooth' });
        }

        function showCustomMessage(msg) {
            const alert = document.getElementById('custom-alert');
            const msgEl = document.getElementById('alert-message');
            msgEl.textContent = msg;
            
            alert.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                alert.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
</body>
</html>
