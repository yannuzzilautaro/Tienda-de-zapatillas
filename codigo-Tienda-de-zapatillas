                    <button onclick="scrollCarrusel(-1)" class="p-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition"><i class="fa-solid fa-chevron-left"></i></button>
                    <button onclick="scrollCarrusel(1)" class="p-2 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 transition"><i class="fa-solid fa-chevron-right"></i></button>
                </div>
            </div>

            <div id="carrusel-container" class="flex gap-6 overflow-x-auto no-scrollbar scroll-smooth py-2">

                <div class="min-w-[280px] sm:min-w-[340px] bg-white dark:bg-slate-900 rounded-2xl p-4 border border-slate-100 dark:border-slate-800 shadow-sm hover:shadow-md transition flex flex-col justify-between">
                    <div class="relative overflow-hidden rounded-xl bg-slate-100 dark:bg-slate-800 aspect-video mb-4">
                        <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&q=80&w=600" alt="Zapatilla Red Speed Runner" class="w-full h-full object-cover transform hover:scale-105 transition duration-500">
                        <span class="absolute top-2 left-2 bg-indigo-600 text-white text-xs font-bold px-2.5 py-1 rounded-lg">Nuevo</span>
                    </div>
